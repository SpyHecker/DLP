import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras import layers, models

print("TensorFlow Version:", tf.__version__)

# Load training and testing datasets
train_df = pd.read_csv('sign_mnist_train.csv')
test_df = pd.read_csv('sign_mnist_test.csv')

# Separate target labels and pixel features
y_train = train_df['label'].values
X_train = train_df.drop('label', axis=1).values

y_test = test_df['label'].values
X_test = test_df.drop('label', axis=1).values

# Normalize pixel values from [0, 255] to [0, 1]
X_train = X_train.astype('float32') / 255.0
X_test = X_test.astype('float32') / 255.0

# Reshape into (num_samples, 28, 28, 1) for 2D Convolution
X_train = X_train.reshape(-1, 28, 28, 1)
X_test = X_test.reshape(-1, 28, 28, 1)

print(f"Training set shape: {X_train.shape} | Labels shape: {y_train.shape}")
print(f"Testing set shape:  {X_test.shape}  | Labels shape: {y_test.shape}")

model = models.Sequential([
    # 1st Convolution & Pooling Block
    layers.Conv2D(32, (3, 3), activation='relu', padding='same', input_shape=(28, 28, 1)),
    layers.MaxPooling2D((2, 2)),
    
    # 2nd Convolution & Pooling Block
    layers.Conv2D(64, (3, 3), activation='relu', padding='same'),
    layers.MaxPooling2D((2, 2)),
    
    # 3rd Convolution & Pooling Block
    layers.Conv2D(128, (3, 3), activation='relu', padding='same'),
    layers.MaxPooling2D((2, 2)),
    
    # Flatten & Classification Head
    layers.Flatten(),
    layers.Dense(128, activation='relu'),
    layers.Dropout(0.3),
    layers.Dense(25, activation='softmax')  # 25 units for labels 0-24 (J=9 skipped)
])

model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

model.summary()

# Train the CNN and track testing accuracy/loss across epochs
history = model.fit(
    X_train, y_train,
    epochs=15,
    batch_size=64,
    validation_data=(X_test, y_test),
    verbose=1
)

train_loss, train_accuracy = model.evaluate(X_train, y_train, verbose=0)
test_loss, test_accuracy = model.evaluate(X_test, y_test, verbose=0)

print(f"Final Training Accuracy: {train_accuracy * 100:.2f}% | Training Loss: {train_loss:.4f}")
print(f"Final Testing Accuracy:  {test_accuracy * 100:.2f}% | Testing Loss:  {test_loss:.4f}")

epochs_range = range(1, len(history.history['accuracy']) + 1)

plt.figure(figsize=(12, 5))

# 1. Training vs Testing Accuracy Graph
plt.subplot(1, 2, 1)
plt.plot(epochs_range, history.history['accuracy'], label='Training Accuracy', marker='o', markersize=4)
plt.plot(epochs_range, history.history['val_accuracy'], label='Testing Accuracy', marker='s', markersize=4)
plt.title('CNN Training and Testing Accuracy')
plt.xlabel('Epochs')
plt.ylabel('Accuracy')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()

# 2. Training vs Testing Loss Graph
plt.subplot(1, 2, 2)
plt.plot(epochs_range, history.history['loss'], label='Training Loss', marker='o', markersize=4)
plt.plot(epochs_range, history.history['val_loss'], label='Testing Loss', marker='s', markersize=4)
plt.title('CNN Training and Testing Loss')
plt.xlabel('Epochs')
plt.ylabel('Loss')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()

plt.tight_layout()
plt.show()
