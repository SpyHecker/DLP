import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras import layers, models

print("TensorFlow Version:", tf.__version__)

# Load CIFAR-10 dataset directly from TensorFlow/Keras
(X_train, y_train), (X_test, y_test) = tf.keras.datasets.cifar10.load_data()

# Flatten 2D label arrays (num_samples, 1) into 1D arrays (num_samples,)
y_train = y_train.flatten()
y_test = y_test.flatten()

# Define the 10 CIFAR-10 object category names (labels 0-9)
class_names = [
    'Airplane', 'Automobile', 'Bird', 'Cat', 'Deer',
    'Dog', 'Frog', 'Horse', 'Ship', 'Truck'
]

# Normalize RGB pixel values from [0, 255] to [0, 1]
X_train = X_train.astype('float32') / 255.0
X_test = X_test.astype('float32') / 255.0

print(f"Training set shape: {X_train.shape} | Labels shape: {y_train.shape}")
print(f"Testing set shape:  {X_test.shape}  | Labels shape: {y_test.shape}")

model = models.Sequential([
    layers.Flatten(input_shape=(32, 32, 3)),
    layers.Dense(512, activation='relu'),
    layers.Dropout(0.2),
    layers.Dense(256, activation='relu'),
    layers.Dropout(0.2),
    layers.Dense(128, activation='relu'),
    layers.Dense(10, activation='softmax')  # 10 object classes (0-9)
])

model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

model.summary()

history = model.fit(
    X_train, y_train,
    epochs=20,
    batch_size=64,
    validation_split=0.2,
    verbose=1
)

test_loss, test_accuracy = model.evaluate(X_test, y_test, verbose=0)
print(f"\nTest Loss:     {test_loss:.4f}")
print(f"Test Accuracy: {test_accuracy * 100:.2f}%")

# Select 5 random test images
np.random.seed(42)
sample_indices = np.random.choice(len(X_test), size=5, replace=False)

sample_images = X_test[sample_indices]
sample_actual = y_test[sample_indices]

# Predict class probabilities and extract predicted class indices
pred_probs = model.predict(sample_images, verbose=0)
sample_preds = np.argmax(pred_probs, axis=1)
sample_conf = np.max(pred_probs, axis=1) * 100

# Plot the 5 color test images with Actual vs. Predicted Class Labels
plt.figure(figsize=(15, 3.8))
for i in range(5):
    plt.subplot(1, 5, i + 1)
    plt.imshow(sample_images[i])
    
    actual_label = class_names[sample_actual[i]]
    pred_label = class_names[sample_preds[i]]
    
    title_color = 'green' if actual_label == pred_label else 'red'
    plt.title(f"Actual: {actual_label}\nPred: {pred_label}\n({sample_conf[i]:.1f}%)",
              color=title_color, fontweight='bold', fontsize=10)
    plt.axis('off')

plt.tight_layout()
plt.show()

# Display formatted summary table of Actual vs. Predicted Class Labels
results_df = pd.DataFrame({
    'Test Sample Index': sample_indices,
    'Actual Class ID': sample_actual,
    'Actual Object Category': [class_names[idx] for idx in sample_actual],
    'Predicted Class ID': sample_preds,
    'Predicted Object Category': [class_names[idx] for idx in sample_preds],
    'Confidence (%)': np.round(sample_conf, 2)
})

print("\nPredicted Class Labels for Sample Test Images:")
display(results_df)
