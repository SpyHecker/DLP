import os
import glob
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras import layers, models
from tensorflow.keras.applications import VGG16
from tensorflow.keras.applications.vgg16 import preprocess_input
from tensorflow.keras.preprocessing.image import load_img, img_to_array
from tensorflow.keras.utils import to_categorical
from sklearn.model_selection import train_test_split

print("TensorFlow Version:", tf.__version__)

DATASET_DIR = '101_ObjectCategories'

# (a) Select 6 object categories (within the requested 5-10 categories range)
selected_categories = ['airplanes', 'Motorbikes', 'Faces', 'watch', 'sunflower', 'laptop']

if os.path.exists(DATASET_DIR):
    available_dirs = [d for d in sorted(os.listdir(DATASET_DIR)) 
                      if os.path.isdir(os.path.join(DATASET_DIR, d)) and d != 'BACKGROUND_Google']
    if not all(cat in available_dirs for cat in selected_categories):
        selected_categories = available_dirs[:6]
    print(f"Selected {len(selected_categories)} Object Categories:", selected_categories)
    
    images_raw, labels = [], []
    for class_idx, category in enumerate(selected_categories):
        cat_path = os.path.join(DATASET_DIR, category)
        img_files = (glob.glob(os.path.join(cat_path, '*.jpg')) + 
                     glob.glob(os.path.join(cat_path, '*.jpeg')) + 
                     glob.glob(os.path.join(cat_path, '*.png')))
        for img_path in img_files[:120]:
            # (b) Resize image to 224 x 224 pixels
            img = load_img(img_path, target_size=(224, 224))
            images_raw.append(img_to_array(img))
            labels.append(class_idx)
            
    images_raw = np.array(images_raw, dtype='float32')
    labels = np.array(labels)
else:
    # Fallback: Load via tensorflow_datasets if local directory is not present
    import tensorflow_datasets as tfds
    ds, info = tfds.load('caltech101', split='train+test', with_info=True, as_supervised=True)
    all_label_names = info.features['label'].names
    target_indices = [i for i, name in enumerate(all_label_names) if name.lower() != 'background_google'][:6]
    selected_categories = [all_label_names[i] for i in target_indices]
    print(f"Selected {len(selected_categories)} Object Categories via TFDS:", selected_categories)
    
    images_raw, labels = [], []
    for img, lbl in tfds.as_numpy(ds):
        if lbl in target_indices:
            img_resized = tf.image.resize(img, (224, 224)).numpy()
            images_raw.append(img_resized)
            labels.append(target_indices.index(lbl))
    images_raw = np.array(images_raw, dtype='float32')
    labels = np.array(labels)

# Split into Training (80%) and Testing (20%) sets
X_train_raw, X_test_raw, y_train_idx, y_test_idx = train_test_split(
    images_raw, labels, test_size=0.2, random_state=42, stratify=labels
)

# Preprocess images using VGG16 preprocess_input
X_train = preprocess_input(X_train_raw.copy())
X_test = preprocess_input(X_test_raw.copy())

# One-hot encode labels for categorical_crossentropy loss
num_classes = len(selected_categories)
y_train = to_categorical(y_train_idx, num_classes=num_classes)
y_test = to_categorical(y_test_idx, num_classes=num_classes)

print(f"Training set shape: {X_train.shape} | One-hot labels shape: {y_train.shape}")
print(f"Testing set shape:  {X_test.shape}  | One-hot labels shape: {y_test.shape}")

# (c) Load pre-trained VGG16 model with ImageNet weights, excluding top classification layers
base_model = VGG16(
    weights='imagenet',
    include_top=False,
    input_shape=(224, 224, 3)
)

# (d) Freeze the lower convolutional layers of VGG16 to retain pre-trained features
base_model.trainable = False
for layer in base_model.layers:
    layer.trainable = False

print(f"VGG16 Base Loaded. Total layers: {len(base_model.layers)} | Trainable: {base_model.trainable}")

# (e) Add custom classification head with GlobalAveragePooling2D, TWO Dense(ReLU) layers, Dropout, and Softmax
model = models.Sequential([
    base_model,
    layers.GlobalAveragePooling2D(name='GlobalAvgPool'),
    layers.Dense(256, activation='relu', name='Custom_Dense_1'),
    layers.Dense(128, activation='relu', name='Custom_Dense_2'),
    layers.Dropout(0.4, name='Custom_Dropout'),
    layers.Dense(num_classes, activation='softmax', name='Softmax_Output')
], name='VGG16_TwoDense_Classifier')

# (f) Compile using Adam optimizer and categorical cross-entropy loss
model.compile(
    optimizer='adam',
    loss='categorical_crossentropy',
    metrics=['accuracy']
)

model.summary()

# (g) Train the model with a 20% validation split
history = model.fit(
    X_train, y_train,
    epochs=12,
    batch_size=32,
    validation_split=0.2,
    verbose=1
)


# (h) Display Training, Validation, and Testing Accuracy
final_train_acc = history.history['accuracy'][-1]
final_val_acc = history.history['val_accuracy'][-1]
test_loss, test_acc = model.evaluate(X_test, y_test, verbose=0)

print(f"Final Training Accuracy:   {final_train_acc * 100:.2f}%")
print(f"Final Validation Accuracy: {final_val_acc * 100:.2f}%")
print(f"Final Testing Accuracy:    {test_acc * 100:.2f}% | Test Loss: {test_loss:.4f}\n")

# Plot Training vs. Validation Accuracy and Loss Graphs
epochs_range = range(1, len(history.history['accuracy']) + 1)
plt.figure(figsize=(12, 4.5))

plt.subplot(1, 2, 1)
plt.plot(epochs_range, history.history['accuracy'], label='Training Accuracy', marker='o', markersize=4)
plt.plot(epochs_range, history.history['val_accuracy'], label='Validation Accuracy', marker='s', markersize=4)
plt.title('Training and Validation Accuracy (VGG16 Transfer Learning)')
plt.xlabel('Epochs')
plt.ylabel('Accuracy')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()

plt.subplot(1, 2, 2)
plt.plot(epochs_range, history.history['loss'], label='Training Loss', marker='o', markersize=4)
plt.plot(epochs_range, history.history['val_loss'], label='Validation Loss', marker='s', markersize=4)
plt.title('Training and Validation Loss (VGG16 Transfer Learning)')
plt.xlabel('Epochs')
plt.ylabel('Loss')
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend()

plt.tight_layout()
plt.show()

# Predict object categories for 5 sample test images
np.random.seed(42)
sample_indices = np.random.choice(len(X_test), size=5, replace=False)

sample_inputs = X_test[sample_indices]
sample_raw_imgs = X_test_raw[sample_indices].astype('uint8')
sample_actual_idx = y_test_idx[sample_indices]

pred_probs = model.predict(sample_inputs, verbose=0)
sample_pred_idx = np.argmax(pred_probs, axis=1)
sample_conf = np.max(pred_probs, axis=1) * 100

plt.figure(figsize=(15, 4))
for i in range(5):
    plt.subplot(1, 5, i + 1)
    plt.imshow(sample_raw_imgs[i])
    
    actual_cat = selected_categories[sample_actual_idx[i]]
    pred_cat = selected_categories[sample_pred_idx[i]]
    
    title_color = 'green' if actual_cat == pred_cat else 'red'
    plt.title(f"Actual: {actual_cat}\nPred: {pred_cat}\n({sample_conf[i]:.1f}%)",
              color=title_color, fontweight='bold', fontsize=10)
    plt.axis('off')

plt.tight_layout()
plt.show()

# Display comparison table
results_df = pd.DataFrame({
    'Test Sample Index': sample_indices,
    'Actual Object Category': [selected_categories[idx] for idx in sample_actual_idx],
    'Predicted Object Category': [selected_categories[idx] for idx in sample_pred_idx],
    'Confidence (%)': np.round(sample_conf, 2),
    'Status': ['Correct' if a == p else 'Incorrect' for a, p in zip(sample_actual_idx, sample_pred_idx)]
})
display(results_df)
